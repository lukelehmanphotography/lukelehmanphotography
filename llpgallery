// Basic client gallery site with admin login and gallery view
import { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";

const galleries = [
  { id: 1, title: "Smith Wedding", cover: "/galleries/smith/cover.jpg" },
  { id: 2, title: "Johnson Seniors", cover: "/galleries/johnson/cover.jpg" },
  { id: 3, title: "Peterson Family", cover: "/galleries/peterson/cover.jpg" },
];

export default function GallerySite() {
  const [adminLoggedIn, setAdminLoggedIn] = useState(false);
  const [password, setPassword] = useState("");

  const handleLogin = () => {
    if (password === "admin123") setAdminLoggedIn(true);
  };

  return (
    <div className="min-h-screen p-6 bg-gray-50">
      <h1 className="text-3xl font-bold text-center mb-6">Client Galleries</h1>

      {!adminLoggedIn ? (
        <div className="max-w-sm mx-auto bg-white p-4 rounded-xl shadow-md">
          <h2 className="text-xl font-semibold mb-2">Admin Login</h2>
          <Input
            type="password"
            placeholder="Enter admin password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
          />
          <Button className="mt-3 w-full" onClick={handleLogin}>Login</Button>
        </div>
      ) : (
        <div className="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {galleries.map((gallery) => (
            <Card key={gallery.id}>
              <img src={gallery.cover} alt={gallery.title} className="rounded-t-xl w-full h-48 object-cover" />
              <CardContent>
                <h3 className="text-lg font-semibold mb-2">{gallery.title}</h3>
                <Button>Open Gallery</Button>
              </CardContent>
            </Card>
          ))}
        </div>
      )}
    </div>
  );
}
